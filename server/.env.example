# ==========================================
# AttendIQ API (Express + MongoDB) — copy to server/.env
# On Render, set these in the service's Environment tab. Never commit real values.
# ==========================================

# --- Server ---
PORT=
# development | production
NODE_ENV=

# --- Database (MongoDB Atlas connection string in production) ---
MONGODB_URI=

# --- Browser access ---
# Comma-separated list of allowed frontend origins, e.g. https://attendiq.vercel.app
CORS_ORIGIN=
# lax (same site) | none (frontend and API on different domains, requires HTTPS) | strict
COOKIE_SAMESITE=

# --- Authentication (required in production) ---
# Random string, at least 32 characters
JWT_SECRET=
# Session lifetime, e.g. 7d
JWT_EXPIRES_IN=

# --- Face data protection (required in production) ---
# 64 hex characters (32 bytes) used for AES-256-GCM encryption of face signatures.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it later makes existing enrollments unreadable (students must re-enroll).
FACE_ENCRYPTION_KEY=
# Optional tuning (defaults: 0.5 and 0.6)
FACE_MATCH_THRESHOLD=
FACE_PEAK_MAX_DISTANCE=

# --- AI recommendations (optional; rule-based engine is used without a key) ---
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5
AI_MODEL=
# Set to false to force rule-based recommendations
AI_RECOMMENDATIONS_ENABLED=
AI_TIMEOUT_MS=

# --- Demo data ---
# true seeds demo accounts and six weeks of demo history on start (default: true in development, false in production)
SEED_DEMO_DATA=
