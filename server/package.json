{
  "name": "attendiq-server",
  "version": "1.0.0",
  "description": "AttendIQ Backend API Server (Node.js + Express.js + Mongoose)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "seed": "ts-node-dev --transpile-only src/utils/seedData.ts",
    "start": "node dist/index.js",
    "seed:reset": "ts-node-dev --transpile-only src/utils/seedReset.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.5.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  },
  "engines": {
    "node": ">=20"
  }
}
