# ==========================================
# AttendIQ frontend (Next.js) — copy to .env.local
# On Vercel, set these in Project Settings → Environment Variables.
# ==========================================

# Public URL of the Express API, including /api
# Local: http://localhost:5000/api   Production: https://<your-render-service>.onrender.com/api
NEXT_PUBLIC_API_BASE_URL=

# Show the demo-account hint box on the login page (true for hackathon demos, false otherwise)
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=
